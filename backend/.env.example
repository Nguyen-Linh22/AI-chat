# ==============================================================================
# AI Chat Clone - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the values for your deployment.
# DO NOT commit .env with real secrets to version control.

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# [Optional] Application port (default: 3000, usually set automatically by PaaS)
PORT=3000

# [Optional] Environment mode: 'development', 'production', or 'test' (default: development)
NODE_ENV=production

# [Optional] Trust reverse proxy headers (e.g., X-Forwarded-For) (default: true in production)
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# 2. Database Configuration (Required)
# ------------------------------------------------------------------------------
# PostgreSQL connection string with pgvector extension enabled
DATABASE_URL="postgresql://user:password@localhost:5432/ai_chat_db?schema=public"

# ------------------------------------------------------------------------------
# 3. Authentication & Security (Required)
# ------------------------------------------------------------------------------
# Secret key used to sign JWT authentication tokens (generate a strong random string)
JWT_SECRET=your-production-jwt-secret-at-least-32-chars

# [Optional] JWT expiration time (default: 7d)
JWT_EXPIRES_IN=7d

# [Optional] Bcrypt hashing salt rounds (default: 10)
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# 4. CORS Configuration (Required for Production)
# ------------------------------------------------------------------------------
# Allowed origin for frontend application (no trailing slash)
# In production, requests from other origins will be blocked.
FRONTEND_URL=https://your-frontend-domain.com

# ------------------------------------------------------------------------------
# 5. AI Provider Configuration
# ------------------------------------------------------------------------------
# Active AI provider: 'gemini' | 'openai' | 'groq' | 'ollama'
# (Required in production. In development, defaults to 'ollama')
AI_PROVIDER=gemini

# [Optional] Global AI request timeout in milliseconds (default: 30000)
AI_TIMEOUT_MS=30000

# Provider API Keys (Set the key corresponding to your chosen AI_PROVIDER):
# - Gemini (Required if AI_PROVIDER=gemini, or when using RAG document embedding)
GEMINI_API_KEY=your-gemini-api-key

# - OpenAI (Required only if AI_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key

# - Groq (Required only if AI_PROVIDER=groq)
GROQ_API_KEY=your-groq-api-key

# - Ollama (Required in production only if AI_PROVIDER=ollama; defaults to http://localhost:11434 in dev)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 6. File Uploads - Cloudinary (Optional)
# ------------------------------------------------------------------------------
# Required only if image/attachment uploads are enabled
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
