# ==============================================================================
# AI Chat Clone - Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.production and set the backend API base URL.
# In Vite, only variables prefixed with VITE_ are exposed to the client.

# Backend API base URL (no trailing slash)
# Development: http://localhost:3000
# Production: https://api.yourdomain.com (or leave empty if using reverse proxy / same-domain)
VITE_API_URL=http://localhost:3000

# Google Identity Services (GIS) Web Client ID (OAuth 2.0 Client ID for Web Applications)
# Development: your-google-client-id.apps.googleusercontent.com
# Production (Vercel): configured in Vercel Project Settings > Environment Variables
# Must match GOOGLE_CLIENT_ID on the backend.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
